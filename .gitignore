# Byte-compiled Python (from running .github/scripts/test_plan.py locally --
# caught during Phase 4 review: it's easy to `git add -A` one of these by
# accident otherwise).
__pycache__/
*.pyc

# Local Claude Code settings (.claude/settings.local.json). A global ignore
# already covers it on Richard's machines; this line keeps it ignored for
# anyone without that global file.
.claude/
