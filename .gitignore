# Byte-compiled Python, created when you run .github/scripts/test_plan.py
# locally. Without this rule, `git add -A` can add these files by accident
# (found in the Phase 4 review).
__pycache__/
*.pyc

# Local Claude Code settings (.claude/settings.local.json). A global ignore
# file covers it on Richard's machines. This line ignores it for anyone who
# does not have that global file.
.claude/
